# docker compose bu dosyayı ".env" adıyla otomatik okur:  cp .env.example .env
# Tüm değerlerin varsayılanı vardır; üretimde en azından şifreleri ve JWT_SECRET'ı değiştirin.

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5434

# En az 32 karakter
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-anahtar-yazin

# Varsayılan İK yöneticisi (ik_admin) şifresi - yalnızca ilk açılışta kullanılır
IK_ADMIN_SIFRE=teias2026

# Demo birim sorumlusu ve demo öğrenci oluşturulsun mu?
DEMO_VERI=true

BACKEND_PORT=8080
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200
